# Yahoo Fantasy API credentials for V5 (live scoring, eligibility, draft results).
#
# HOW TO USE
# 1. Copy this file to `.env` (which is git-ignored - never commit the real one):
#        cp .env.example .env
# 2. Create a Yahoo developer app at https://developer.yahoo.com/apps/create/
#    - Application Type: Installed Application
#    - API Permissions: Fantasy Sports (Read)
#    Yahoo will give you a Client ID (consumer key) and Client Secret.
# 3. Paste them below, plus your league id and game code.
# 4. The FIRST run will open a browser for you to authorise the app once; yfpy then
#    caches a token. The agent does NOT and CANNOT perform this step for you.
#
# Find your league id in the league URL:
#   https://basketball.fantasysports.yahoo.com/nba/<LEAGUE_ID>
# Game code is "nba" for current-season basketball.

YAHOO_CONSUMER_KEY=your-client-id-here
YAHOO_CONSUMER_SECRET=your-client-secret-here
YAHOO_LEAGUE_ID=123456
YAHOO_GAME_CODE=nba
